{
  "name": "eyepiece",
  "displayName": "Eyepiece",
  "description": "View Rust in a language you know, edit it, review the proposed Rust change, and apply with Cargo checks.",
  "version": "0.0.1",
  "publisher": "maxhightower",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maxhightower/Eyepiece.git"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Welcome and sample only; model requests, source edits, and Cargo checks require workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "EYE-1 requires local Rust files and Cargo."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "eyepiece.openWelcome",
        "title": "Eyepiece: Open Welcome"
      },
      {
        "command": "eyepiece.openSample",
        "title": "Eyepiece: Open Rust Sample"
      },
      {
        "command": "eyepiece.showStatus",
        "title": "Eyepiece: Show Status"
      },
      {
        "command": "eyepiece.openSettings",
        "title": "Eyepiece: Open Settings"
      },
      {
        "command": "eyepiece.translate",
        "title": "Eyepiece: Open Panel",
        "icon": "$(eye)"
      },
      {
        "command": "eyepiece.preview",
        "title": "Eyepiece: Preview Rust Change",
        "icon": "$(git-compare)"
      },
      {
        "command": "eyepiece.apply",
        "title": "Eyepiece: Apply and Run Checks",
        "icon": "$(check)"
      },
      {
        "command": "eyepiece.reopenDraft",
        "title": "Eyepiece: Reopen saved draft"
      },
      {
        "command": "eyepiece.enableCopilot",
        "title": "Eyepiece: Enable Copilot"
      }
    ],
    "configuration": {
      "title": "Eyepiece",
      "properties": {
        "eyepiece.targetLanguage": {
          "type": "string",
          "default": "python",
          "enum": [
            "english",
            "python",
            "typescript",
            "javascript",
            "go",
            "java",
            "csharp",
            "cpp"
          ],
          "enumItemLabels": [
            "English",
            "Python",
            "TypeScript",
            "JavaScript",
            "Go",
            "Java",
            "C#",
            "C++"
          ],
          "description": "Language the Rust source is shown in. English gives a plain-language explanation."
        },
        "eyepiece.provider": {
          "type": "string",
          "enum": [
            "none",
            "copilot",
            "chatgpt",
            "claudeCode"
          ],
          "default": "none",
          "description": "Select Copilot to enable EYE-1 model requests. No separate Eyepiece account.",
          "enumDescriptions": [
            "Disabled",
            "Use GitHub Copilot through the VS Code Language Model API",
            "Planned; not implemented",
            "Planned; not implemented"
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "eyepiece",
          "title": "Eyepiece",
          "icon": "media/eyepiece.svg"
        }
      ]
    },
    "views": {
      "eyepiece": [
        {
          "type": "webview",
          "id": "eyepiece.actions",
          "name": "Eyepiece"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "eyepiece.translate",
          "when": "resourceLangId == rust && resourceScheme == file",
          "group": "navigation@-1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test:unit": "npm run compile && node --test out/test/unit/*.test.js",
    "test:host": "npm run compile && npm run build:webview && node scripts/test-host.cjs",
    "test:fixture": "cargo test --locked --manifest-path fixtures/rust/Cargo.toml",
    "check": "npm run test:unit && npm run test:fixture && npm run test:headless",
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "package": "vsce package --allow-missing-repository --skip-license --out eyepiece-0.0.1.vsix",
    "verify:package": "python3 scripts/verify-package.py",
    "test:headless": "npm run compile && node scripts/test-headless.cjs",
    "test:live": "npm run compile && npm run build:webview && node scripts/test-live.cjs",
    "build:webview": "esbuild panel=webview/main.ts sidebar=webview/sidebar.ts --bundle --minify --format=iife --target=es2022 --outdir=media"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/node": "22.20.5",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "typescript": "5.7.3"
  }
}
