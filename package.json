{
  "name": "eyepiece",
  "displayName": "Eyepiece",
  "description": "View any code in plain English or another language, edit it there, review the proposed source change, and apply with project checks.",
  "version": "0.0.1",
  "publisher": "maxhightower",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maxhightower/Eyepiece.git"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Welcome and sample only; model requests, source edits, and project checks require workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Eyepiece requires local files."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "eyepiece.openWelcome",
        "title": "Eyepiece: Open Welcome"
      },
      {
        "command": "eyepiece.openSample",
        "title": "Eyepiece: Open Rust Sample"
      },
      {
        "command": "eyepiece.showStatus",
        "title": "Eyepiece: Show Status"
      },
      {
        "command": "eyepiece.openSettings",
        "title": "Eyepiece: Open Settings"
      },
      {
        "command": "eyepiece.translate",
        "title": "Eyepiece: Open Panel",
        "icon": "$(eye)"
      },
      {
        "command": "eyepiece.preview",
        "title": "Eyepiece: Preview Source Change",
        "icon": "$(git-compare)"
      },
      {
        "command": "eyepiece.apply",
        "title": "Eyepiece: Apply and Run Checks",
        "icon": "$(check)"
      },
      {
        "command": "eyepiece.reopenDraft",
        "title": "Eyepiece: Reopen saved draft"
      },
      {
        "command": "eyepiece.setApiKey",
        "title": "Eyepiece: Change API Key"
      },
      {
        "command": "eyepiece.chooseModel",
        "title": "Eyepiece: Change Model"
      }
    ],
    "configuration": {
      "title": "Eyepiece",
      "properties": {
        "eyepiece.targetLanguage": {
          "type": "string",
          "default": "python",
          "enum": [
            "english",
            "python",
            "rust",
            "typescript",
            "javascript",
            "go",
            "java",
            "csharp",
            "cpp",
            "c",
            "ruby",
            "php",
            "swift",
            "kotlin"
          ],
          "enumItemLabels": [
            "English",
            "Python",
            "Rust",
            "TypeScript",
            "JavaScript",
            "Go",
            "Java",
            "C#",
            "C++",
            "C",
            "Ruby",
            "PHP",
            "Swift",
            "Kotlin"
          ],
          "description": "Language files are shown in. English gives a plain-language explanation."
        },
        "eyepiece.provider": {
          "type": "string",
          "enum": [
            "none",
            "copilot",
            "anthropic",
            "openai",
            "codex",
            "claudeCode"
          ],
          "default": "none",
          "description": "AI provider that receives your code when you click a button. Choose it in the Eyepiece sidebar.",
          "enumDescriptions": [
            "Disabled",
            "GitHub Copilot through the VS Code Language Model API",
            "Anthropic API key, billed by Anthropic",
            "OpenAI API key, billed by OpenAI",
            "Your installed Codex with its ChatGPT sign-in",
            "Your installed Claude Code, for personal use"
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "eyepiece",
          "title": "Eyepiece",
          "icon": "media/eyepiece.svg"
        }
      ]
    },
    "views": {
      "eyepiece": [
        {
          "type": "webview",
          "id": "eyepiece.actions",
          "name": "Eyepiece"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "eyepiece.translate",
          "when": "resourceScheme == file",
          "group": "navigation@-1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test:unit": "npm run compile && node --test out/test/unit/core.test.js out/test/unit/foundation.test.js out/test/unit/providers.test.js",
    "test:host": "npm run compile && npm run build:webview && node scripts/test-host.cjs",
    "test:fixture": "cargo test --locked --manifest-path fixtures/rust/Cargo.toml",
    "check": "npm run test:unit && npm run test:fixture && npm run test:headless",
    "vscode:prepublish": "npm run compile && npm run build:webview && npm run build:extension",
    "package": "vsce package --allow-missing-repository --skip-license --out eyepiece-0.0.1.vsix",
    "verify:package": "python3 scripts/verify-package.py",
    "test:headless": "npm run compile && node scripts/test-headless.cjs",
    "test:live": "npm run compile && npm run build:webview && node scripts/test-live.cjs",
    "build:webview": "esbuild panel=webview/main.ts sidebar=webview/sidebar.ts --bundle --minify --format=iife --target=es2022 --outdir=media",
    "build:extension": "esbuild out/src/extension.js --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/src/extension.js --allow-overwrite"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/node": "22.20.5",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "openai": "6.49.0",
    "typescript": "5.7.3"
  }
}
